{
    "nodeModulesDir": "manual",
    "tasks": {
        "dev": "deno run -A --no-lock --watch backend/main.ts --port 8787",
        "test": "deno test -A --no-lock backend/",
        "check": "deno check --no-lock backend/main.ts && deno task check-endpoints",
        "check-endpoints": "deno run -A --no-lock scripts/check_endpoints.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": false,
        "lineWidth": 120,
        "exclude": ["frontend/dist", "frontend/node_modules", "node_modules", "mapper/target", "icon.svg"]
    },
    "lint": {
        "exclude": ["frontend/dist", "frontend/node_modules", "node_modules", "mapper/target"]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/yaml": "jsr:@std/yaml@1"
    }
}
